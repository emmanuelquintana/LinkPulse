generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspacePlan {
  FREE
  PRO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum LinkStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
  EXPIRED
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

enum NotificationType {
  LINK_CREATED
  LINK_ARCHIVED
  CAMPAIGN_CREATED
  WORKSPACE_CREATED
  MEMBER_ADDED
  BILLING
  SYSTEM
}

model Profile {
  id            String            @id @db.Uuid
  email         String            @unique
  firstName     String?           @map("first_name")
  lastName      String?           @map("last_name")
  avatarUrl     String?           @map("avatar_url")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspaces    Workspace[]       @relation("WorkspaceOwner")
  memberships   WorkspaceMember[]
  links         Link[]            @relation("LinkCreator")
  notifications Notification[]

  @@map("profiles")
}

model Workspace {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String
  ownerUserId          String            @db.Uuid
  plan                 WorkspacePlan     @default(PRO)
  stripeCustomerId     String?           @unique @map("stripe_customer_id")
  stripeSubscriptionId String?           @unique @map("stripe_subscription_id")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  owner                Profile           @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  links                Link[]
  campaigns            Campaign[]
  subscription         Subscription?
  invoices             Invoice[]
  notifications        Notification[]
  emailSubscribers     EmailSubscriber[]
  emailCampaigns       EmailCampaign[]
  emailSettings        EmailSettings?

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceMember {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  userId           String        @db.Uuid
  role             WorkspaceRole @default(MEMBER)
  canManageLinks   Boolean       @default(true) @map("can_manage_links")
  canManageEmails  Boolean       @default(false) @map("can_manage_emails")
  canViewAnalytics Boolean       @default(true) @map("can_view_analytics")
  canManageMembers Boolean       @default(false) @map("can_manage_members")
  canManageBilling Boolean       @default(false) @map("can_manage_billing")
  createdAt        DateTime      @default(now())
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  email            String
  role             WorkspaceRole @default(MEMBER)
  canManageLinks   Boolean       @default(true) @map("can_manage_links")
  canManageEmails  Boolean       @default(false) @map("can_manage_emails")
  canViewAnalytics Boolean       @default(true) @map("can_view_analytics")
  canManageMembers Boolean       @default(false) @map("can_manage_members")
  canManageBilling Boolean       @default(false) @map("can_manage_billing")
  token            String        @unique @default(uuid()) @db.Uuid
  invitedById      String?       @db.Uuid
  status           String        @default("PENDING") // PENDING, ACCEPTED, REVOKED
  acceptedAt       DateTime?     @map("accepted_at")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@map("workspace_invitations")
}

model Campaign {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  name        String     @db.VarChar(255)
  description String?    @db.Text
  status      LinkStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links       Link[]

  @@index([workspaceId])
  @@map("campaigns")
}

model Link {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  campaignId  String?      @db.Uuid
  shortCode   String       @unique @db.VarChar(32)
  customAlias String?      @unique @db.VarChar(64)
  originalUrl String       @db.Text
  title       String?      @db.VarChar(255)
  status      LinkStatus   @default(ACTIVE)
  expiresAt   DateTime?
  createdBy   String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     Profile      @relation("LinkCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickEvents ClickEvent[]

  @@index([workspaceId])
  @@index([campaignId])
  @@index([createdBy])
  @@index([status])
  @@map("links")
}

model ClickEvent {
  id          String     @id @default(uuid()) @db.Uuid
  linkId      String     @db.Uuid
  clickedAt   DateTime   @default(now())
  referer     String?    @db.Text
  country     String?    @db.VarChar(80)
  city        String?    @db.VarChar(120)
  deviceType  DeviceType @default(UNKNOWN)
  browser     String?    @db.VarChar(120)
  os          String?    @db.VarChar(120)
  ipHash      String?    @db.VarChar(255)
  userAgent   String?    @db.Text
  utmSource   String?    @db.VarChar(120)
  utmMedium   String?    @db.VarChar(120)
  utmCampaign String?    @db.VarChar(120)
  createdAt   DateTime   @default(now())
  link        Link       @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
  @@index([clickedAt])
  @@map("click_events")
}

model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @unique @db.Uuid
  status            String
  priceId           String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  stripeInvoiceId String    @unique @map("stripe_invoice_id")
  amount          Int
  currency        String
  status          String
  invoiceUrl      String?   @map("invoice_url")
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  workspaceId String?          @db.Uuid
  type        NotificationType @default(SYSTEM)
  title       String           @db.VarChar(140)
  body        String?          @db.Text
  href        String?          @db.Text
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

model EmailSubscriber {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  email       String
  firstName   String?         @map("first_name")
  lastName    String?         @map("last_name")
  status      String          @default("SUBSCRIBED")
  metadata    Json?           @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        EmailLog[]
  tags        SubscriberTag[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("email_subscribers")
}

model SubscriberTag {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  subscriberId String          @map("subscriber_id") @db.Uuid
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, name])
  @@map("subscriber_tags")
}

model EmailCampaign {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  subject     String
  previewText String?    @map("preview_text")
  senderEmail String     @map("sender_email")
  senderName  String     @map("sender_name")
  htmlContent String     @map("html_content") @db.Text
  cc          String?    @db.Text
  bcc         String?    @db.Text
  replyTo     String?    @map("reply_to")
  status      String     @default("DRAFT")
  sentAt      DateTime?  @map("sent_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        EmailLog[]

  @@index([workspaceId])
  @@map("email_campaigns")
}

model EmailSettings {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @unique @map("workspace_id") @db.Uuid
  provider    String    @default("SMTP")
  smtpHost    String?   @map("smtp_host")
  smtpPort    Int?      @default(587) @map("smtp_port")
  smtpUser    String?   @map("smtp_user")
  smtpPass    String?   @map("smtp_pass") @db.Text
  smtpSecure  Boolean   @default(false) @map("smtp_secure")
  fromEmail   String?   @map("from_email")
  fromName    String?   @map("from_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

model EmailLog {
  id           String          @id @default(uuid()) @db.Uuid
  campaignId   String          @map("campaign_id") @db.Uuid
  subscriberId String          @map("subscriber_id") @db.Uuid
  status       String          @default("PENDING")
  bounceReason String?         @map("bounce_reason") @db.Text
  sentAt       DateTime?       @map("sent_at")
  openedAt     DateTime?       @map("opened_at")
  clickedAt    DateTime?       @map("clicked_at")
  campaign     EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  opens        EmailOpen[]
  clicks       EmailClick[]

  @@index([campaignId])
  @@index([subscriberId])
  @@map("email_logs")
}

model EmailOpen {
  id         String     @id @default(uuid()) @db.Uuid
  emailLogId String     @map("email_log_id") @db.Uuid
  openedAt   DateTime   @default(now()) @map("opened_at")
  ipHash     String?    @map("ip_hash") @db.VarChar(255)
  userAgent  String?    @map("user_agent") @db.Text
  country    String?    @db.VarChar(80)
  city       String?    @db.VarChar(120)
  deviceType DeviceType @default(UNKNOWN) @map("device_type")
  browser    String?    @db.VarChar(120)
  os         String?    @db.VarChar(120)
  emailLog   EmailLog   @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@index([emailLogId])
  @@map("email_opens")
}

model EmailClick {
  id         String     @id @default(uuid()) @db.Uuid
  emailLogId String     @map("email_log_id") @db.Uuid
  url        String     @db.Text
  clickedAt  DateTime   @default(now()) @map("clicked_at")
  ipHash     String?    @map("ip_hash") @db.VarChar(255)
  userAgent  String?    @map("user_agent") @db.Text
  country    String?    @db.VarChar(80)
  city       String?    @db.VarChar(120)
  deviceType DeviceType @default(UNKNOWN) @map("device_type")
  browser    String?    @db.VarChar(120)
  os         String?    @db.VarChar(120)
  emailLog   EmailLog   @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@index([emailLogId])
  @@map("email_clicks")
}
